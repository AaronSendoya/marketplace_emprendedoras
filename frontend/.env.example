# Copia este archivo a .env.local y completa los valores. .env.local no se versiona.
# Next.js carga .env.local en next dev / next build / next start.

# --- Backend ---
# URL base de la API (sin barra final, incluye /api/v1). Solo se usa en el servidor (Server
# Components y rutas del propio frontend): nunca lleva el prefijo NEXT_PUBLIC_, para que el
# navegador nunca vea la URL directa del backend ni pueda saltarse el frontend.
# Local: el backend corre en el puerto 3001 (ver backend/CLAUDE.md).
BACKEND_URL=http://localhost:3001/api/v1

# --- Imágenes de R2 (regla 16) ---
# Ya NO hace falta para mostrar las imágenes: se piden directamente a R2, sin pasar por el optimizador de Next (así una imagen
# borrada al eliminar una cuenta no queda en una copia de este servidor). Solo la usa la vitrina de desarrollo
# (/dev/componentes) para armar direcciones de ejemplo. Dominio público de R2, sin protocolo (el de R2_PUBLIC_URL del backend).
# Mientras el backend no tenga R2 conectado, sus imágenes llegan como memoria://... y se muestra un marcador en su lugar
# (ver src/lib/formato/imagen.ts).
NEXT_PUBLIC_IMAGENES_HOST=
