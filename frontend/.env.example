# Copia este archivo a .env.local y completa los valores. .env.local no se versiona.
# Next.js carga .env.local en next dev / next build / next start.

# --- Backend ---
# URL base de la API (sin barra final, incluye /api/v1). Solo se usa en el servidor (Server
# Components y rutas del propio frontend): nunca lleva el prefijo NEXT_PUBLIC_, para que el
# navegador nunca vea la URL directa del backend ni pueda saltarse el frontend.
# Local: el backend corre en el puerto 3001 (ver backend/CLAUDE.md).
BACKEND_URL=http://localhost:3001/api/v1

# --- Imágenes remotas (regla 16 del backend) ---
# Dominio público de Cloudflare R2 que sirve las imágenes (mismo valor que R2_PUBLIC_URL del
# backend, sin protocolo). Hace falta declararlo en next.config.ts para que next/image pueda
# cargarlas. Mientras el backend no tenga R2 conectado (paso 10b), sus imágenes llegan como
# memoria://... y no son URLs http: los componentes de imagen muestran un marcador en su lugar
# (ver src/lib/formato/imagen.ts), así que esta variable puede quedar vacía por ahora.
NEXT_PUBLIC_IMAGENES_HOST=
