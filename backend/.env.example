# Copia este archivo a .env.local y completa los valores. .env.local no se versiona.
# Next.js carga .env.local en next dev / next build / next start.
# En Hostinger las variables se cargan en el panel de la app Node.js (una por servicio).

# --- Entorno ---
# development | test | production. El seed de desarrollo se niega a correr si no es "development".
APP_ENV=development

# --- Base de datos (MySQL) ---
# Desarrollo local: MySQL de tu computador (ver docs/ENTORNO_LOCAL.md para crear las bases y el usuario).
# Formato: mysql://usuario:clave@host:3306/base. Los caracteres especiales de la clave (@ : / # ?) van
# codificados (encodeURIComponent); lo más simple es usar una clave solo con letras y números.
# Opcional al final de la URL: ?ssl=true (TLS con verificación) o ?ssl=no-verify.
DATABASE_URL=mysql://usuario:clave@127.0.0.1:3306/catalogo_dev
# Máximo de conexiones del pool (por defecto 5). Hostinger limita las conexiones simultáneas por usuario.
DATABASE_POOL_MAX=5
# Base de pruebas: solo para pnpm test:integration. Su nombre debe contener "test" y nunca puede ser
# la misma base que DATABASE_URL.
DATABASE_URL_TEST=mysql://usuario:clave@127.0.0.1:3306/catalogo_test

# --- Producción en Hostinger (MÁS ADELANTE: dejar comentado en el computador) ---
# Con la base de Hostinger todavía sin crear, estas líneas son solo la plantilla. Los datos salen de
# hPanel, en Bases de datos (los nombres suelen llevar un prefijo del tipo u123456789_).
#
# 1) App desplegada: base y backend comparten servidor, así que el host es localhost. Estas variables
#    se cargan en el panel de la app Node.js de Hostinger, no en un archivo:
# APP_ENV=production
# SWAGGER_ENABLED=false   (Swagger solo existe en desarrollo, regla 17)
# DATABASE_URL=mysql://USUARIO_HOSTINGER:CLAVE_HOSTINGER@localhost:3306/BASE_HOSTINGER
# CORS_ALLOWED_ORIGINS=https://catalogo.midominio.com
#
# 2) Migrar desde tu computador (una sola vez): activa "MySQL remoto" en hPanel con tu IP y pasa la URL
#    por la terminal, SIN escribirla aquí:
#      DATABASE_URL="mysql://USUARIO:CLAVE@HOST_REMOTO_HOSTINGER:3306/BASE?ssl=true" pnpm db:migrate
#
# 3) Producción temporal en TiDB Cloud (decisión del cliente): puerto 4000, usuario con prefijo y ?ssl=true.
#    Mismo procedimiento que en 2), pasando la URL por la terminal. Pasos en docs/TIDB.md.
#      DATABASE_URL="mysql://PREFIJO.catalogo_app:CLAVE@gateway01.REGION.prod.aws.tidbcloud.com:4000/catalogo_prod?ssl=true"
#
# NO descomentes la URL de Hostinger junto a la local: con ella, pnpm dev y las pruebas trabajarían
# sobre datos reales. Guía completa: docs/ENTORNO_LOCAL.md

# --- Seguridad ---
# Clave de firma de los JWT (HS256). Mínimo 32 caracteres. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Orígenes del frontend permitidos por CORS, separados por comas (sin barra final).
# En local el frontend corre en :3000 y este backend en :3001.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Swagger (/docs y /api/v1/openapi.json) SOLO en desarrollo (regla 17): true con APP_ENV=development;
# en producción déjalo en false o sin definir (con true el servidor no arranca; fuera de desarrollo esas
# rutas responden 404).
SWAGGER_ENABLED=true

# --- Cloudflare R2 (imágenes) ---
# PENDIENTE (postergado por el cliente: el alta de R2 exige una tarjeta): cargar estas cinco variables,
# en .env.local para desarrollo y en el panel de la app Node.js de Hostinger para producción (donde
# son obligatorias). Mientras estén vacías, en desarrollo las imágenes se guardan en memoria (se pierden
# al reiniciar y sus URLs no abren en el navegador). Al conectarlas: pnpm r2:subir-defaults, y subir una
# imagen real para comprobar que su URL pública abre.
# Usa un bucket SOLO de desarrollo (ej. catalogo-dev), con su propio token "Object Read & Write";
# producción tendrá otro bucket y otro token. Las cinco variables van juntas (o las cinco vacías).
# Pasos en docs/ENTORNO_LOCAL.md.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# URL pública del bucket, sin barra final. En desarrollo: la "Public Development URL" (https://pub-...r2.dev,
# con límite de peticiones). En producción: un dominio propio, ej. https://cdn.midominio.com
R2_PUBLIC_URL=

# --- Respaldos cifrados (regla 17, pnpm db:backup) ---
# Clave AES-256 en base64, para cifrar y descifrar los respaldos. Nunca la subas junto con ellos:
# si se pierde, los respaldos ya hechos quedan ilegibles para siempre. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BACKUP_ENCRYPTION_KEY=
# Bucket PRIVADO y separado del de las imágenes (R2_BUCKET), con un token propio de "Object Read &
# Write" que solo alcance a este bucket. Sin estas cuatro variables, pnpm db:backup deja el
# respaldo cifrado solo en backups/ (local, ignorado por git) y avisa que hay que moverlo aparte.
R2_BACKUPS_ACCOUNT_ID=
R2_BACKUPS_ACCESS_KEY_ID=
R2_BACKUPS_SECRET_ACCESS_KEY=
R2_BACKUPS_BUCKET=

# --- Correo (OTP) ---
# console: escribe el código en la consola (solo desarrollo; no se admite con APP_ENV=production).
# smtp: envío real (llega en el paso 8b; hasta entonces el servidor falla al enviar).
EMAIL_DRIVER=console
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
